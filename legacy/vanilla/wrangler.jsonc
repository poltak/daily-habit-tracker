{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "bc5b269de681a5c094ecc01bfafe21cb",
  // The production Worker.
  "name": "daylio-clone",
  "main": "./worker.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daylio-clone",
      "database_id": "ae34a2d3-c377-41fc-8cf0-893104abfef8",
      "migrations_dir": "../drizzle"
    }
  ],
  // Hourly removal of expired sessions, challenges, codes and tokens.
  "triggers": {
    "crons": ["0 * * * *"]
  }
}

{
  // This file is at the repository root because the Deploy to Cloudflare
  // button reads the root, and the Worker imports the workspace package
  // common/. See docs/agents/project/decisions.md.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daylio-clone",
  "main": "backend/src/features/core/server/worker.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // `pnpm run build` writes the frontend here, built for the same origin.
    "directory": "frontend/dist",
    "binding": "ASSETS",
    // The Worker answers these paths. The last three are the pages of the
    // frontend router (APP_PAGES in worker.ts). Later phases add the route
    // for /llms.txt, and each new page.
    "run_worker_first": [
      "/api/*",
      "/health",
      "/health/*",
      "/mcp",
      "/oauth/*",
      "/.well-known/*",
      "/llms.txt",
      "/sign-in",
      "/login",
      "/insights",
    ],
    // A path that is not a file or a page gets frontend/public/404.html and a
    // 404 status.
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daylio-clone",
      "database_id": "ae34a2d3-c377-41fc-8cf0-893104abfef8",
      "migrations_dir": "backend/migrations",
    },
  ],
  // Hourly removal of expired sessions, challenges, codes and tokens.
  "triggers": {
    "crons": ["0 * * * *"],
  },
  // Each instance sets its own setup code as a secret on its Worker, in the
  // dashboard or by the Deploy to Cloudflare button.
  // Keep the variables that the dashboard sets. Without this, each deploy
  // deletes them.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
}
